rules_version = '2';

// Reglas de seguridad de la base de datos (Firestore).
// Las aplica el servidor de Firebase: aunque alguien tenga el link o modifique la página,
// no puede leer ni escribir nada que estas reglas no permitan.
//
// Tipos de usuario (campo "rol" en usuarios/{uid}):
//   admin    → todo, más ver y administrar usuarios y el código de la supervisión
//   carga    → leer y cargar datos
//   consulta → sólo leer
service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() { return request.auth != null; }
    function rutaPerfil() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function tienePerfil() { return logueado() && exists(rutaPerfil()); }
    function perfil() { return get(rutaPerfil()).data; }
    function activo() { return tienePerfil() && perfil().activo == true; }
    function esAdmin() { return activo() && perfil().rol == 'admin'; }
    function puedeCargar() { return activo() && perfil().rol in ['admin', 'carga']; }

    // El código de la supervisión sólo lo puede leer el administrador.
    // Al registrarse, las reglas lo comparan desde el servidor: nunca viaja a la página.
    function rutaAcceso() { return /databases/$(database)/documents/config/acceso; }
    // El código guardado se compara sin espacios y en mayúsculas (la app manda el escrito igual),
    // así un espacio de más o una minúscula al cargarlo a mano en la consola no traba los registros.
    function codigoValido(c) {
      return c is string && exists(rutaAcceso())
        && get(rutaAcceso()).data.codigo is string
        && c.size() > 0
        && c == get(rutaAcceso()).data.codigo.replace(' ', '').trim().upper();
    }

    match /config/acceso {
      allow read, write: if esAdmin();
    }

    match /usuarios/{uid} {
      // Cada uno ve su propio perfil; el administrador ve todos.
      allow read: if (logueado() && request.auth.uid == uid) || esAdmin();

      // Registro: la persona crea su propio perfil eligiendo "carga" o "consulta",
      // y sólo si puso bien el código de la supervisión.
      allow create: if logueado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'email', 'rol', 'activo', 'codigo', 'creado'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.rol in ['carga', 'consulta']
        && request.resource.data.activo == true
        && request.resource.data.creado == request.time
        && codigoValido(request.resource.data.codigo);

      // El administrador cambia el tipo o da de baja; cada uno puede cambiar sólo su nombre.
      allow update: if esAdmin()
        || (activo() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre'])
            && request.resource.data.nombre is string
            && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 80);

      allow delete: if esAdmin();
    }

    // Datos de la supervisión (personas, licencias, notas, artículos, calendario…).
    // Se usan a partir de la etapa 3; ya quedan protegidos.
    match /datos/{coleccion}/registros/{id} {
      allow read: if activo();
      allow write: if puedeCargar();
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
